{
  "layer": "top",
  "position": "top",
  "spacing": 15,
  "height": 35,
  "margin-top": 3,
  "margin-left": 225,
  "margin-right": 225,

  "modules-left": [
"custom/tab",
 "ext/workspaces",
 "custom/cliphist",
 "custom/mangolayout"
],
  "modules-center": ["clock"],

  "modules-right": [
    "network",
    "custom/weather",
    "wireplumber",
    "battery",
    "custom/lock",
    "custom/power"
  ],

  "network": {
    "format-wifi": " ",
    "format-ethernet": "     Connected",
    "format-disconnected": "󰼡 ",
    "tooltip-format": "Interface: {ifname}\nIP: {ipaddr}\nSignal: {signalStrength}%",
    "on-click": "kitty -e nmtui"
  },

  "custom/tab": {
    "format": "Apps",
    "on-click": "rofi -show drun"
  },

  "ext/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true
  },
  "tray": {
    "icon-size": 16,
    "spacing": 6
  },

  "wireplumber": {
    "scroll-step": 5,
    "format": "{icon}  {volume}%",
    "format-muted": " muted",
    "on-click": "pavucontrol",
    "format-icons": {
      "default": [""]
    }
  },

  "battery": {
    "format": " {capacity}%",
    "format-charging": " {capacity}% ",
    "format-icons": [" ", "  ", "  ", "  ", "  ", "  ", "  ", "  ", "  ", "  ", "  "],
    "tooltip-format": "Battery: {capacity}%"
  },

  "clock": {
    "format": "{:%I:%M %p}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "custom/cliphist": {
    "format": "󰅇 ",
    "on-click": "cliphist list | rofi -dmenu -p 'Clipboard' | cliphist decode | wl-copy",
    "on-click-right": "cliphist wipe", // Right-click clears your clipboard history
    "tooltip": true,
    "tooltip-format": "Left-click: Open History\nRight-click: Clear History"
  },

  "custom/lock": {
    "format": " ",
    "on-click": "hyprlock",
    "tooltip": true,
    "tooltip-format": "Lock Screen"
  },
  "custom/weather": {
    "format": "  {}",
    "tooltip": true,
    "interval": 1800,
    "exec": "curl -s 'wttr.in/?format=%t' | tr -d '+ \n\r'",
    "return-type": "",
    "on-click": "xdg-open https://wttr.in/"
  },
  "custom/mangolayout": {
   "exec": "/home/Block-master/.config/mango/scripts/mango-layout.sh",
    "format": "   {}",
    "on-click": "mmsg dispatch setlayout next"
  }
}
